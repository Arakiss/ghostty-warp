# ~/.config/ghostty/config — terminal rendering for cmux
# Hand-curated 2026-07-06 (replaces a generated preset that declared
# MonaspiceNe Nerd Font Mono, a font that was never installed).
# Previous config backed up at: config.bak-20260706

# ── Typography ────────────────────────────────────────────────
# Chosen for LEGIBILITY, not theme (2026-07-06 — "the mistake was wanting too
# much cyberpunk"): outline fonts, high x-height, clean at 14pt on retina.
# Primary: JetBrainsMono NF — chosen after A/B against Maple/Monaspace/Iosevka/
# SpaceMono/Gohu/BigBlue. Switch with `vibe font <key>`. Fallbacks below;
# CJK/emoji resolve via CoreText system fallback.
font-family = MonaspiceNe NF
font-family = JetBrainsMono NF
font-family = Maple Mono NF
font-family = CaskaydiaCove NFM
font-size = 14
font-feature = +calt
font-feature = +liga
# Bolder stroke — a real legibility win for outline fonts at ~110ppi
font-thicken = true

# cmux UI (sidebar and surface tab bar)
sidebar-font-size = 13
surface-tab-bar-font-size = 11

# ── Glyph & TUI rendering ─────────────────────────────────────
# Solid box-drawing borders and Unicode-based grapheme width: Claude Code /
# Codex TUIs (braille spinners, box drawing, NF icons) align correctly.
adjust-box-thickness = 1
grapheme-width-method = unicode

# ── Window & cursor ───────────────────────────────────────────
window-padding-x = 10
window-padding-y = 8
cursor-style = bar

# ── Keybinds ──────────────────────────────────────────────────
# shift+enter inserts a newline (essential in the Claude Code prompt)
keybind = shift+enter=text:\x1b\r

# The `vibe` switcher writes a machine-local block here (theme + wallpaper paths).
# It is intentionally NOT committed — wallpaper paths are per-machine and some
# wallpapers are third-party/copyright. Local block lives in local.conf (gitignored);
# ghostty loads it if present. Run `vibe cyberpunk` (etc.) to generate it.
config-file = ?local.conf
